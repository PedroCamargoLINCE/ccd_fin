# Dados brutos (não publicar)
*.xlsx
*.xls
*.ods
*.csv
Taxas/

# Cache e artefatos gerados (results/ é versionado, reports/ é working dir)
# reports/* (não 'reports/') para que !reports/.gitkeep consiga re-incluir o
# placeholder — com 'reports/' o git ignora o diretório inteiro e a negação
# não tem efeito.
reports/*
!reports/.gitkeep
data/processed/
lightning_logs/
*.ckpt
*.parquet
# results/ NÃO está aqui — é versionado de propósito.
# IMPORTANTE: as regras *.csv/*.ods/*.xlsx acima também ignorariam as tabelas
# geradas em results/. Re-incluímos explicitamente os artefatos de results/
# (tabelas .csv e .md) para que sejam versionados — esta era a causa do
# "results vazio": as figuras .png subiam, mas as tabelas .csv eram ignoradas.
!results/
!results/**/
!results/**/*.csv
!results/**/*.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Envs
.venv/
venv/
.env

# IDE
.vscode/
.idea/
.specstory/

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# CatBoost training artifacts
catboost_info/

# pacotes de entrega (nao versionar)
ccd_*/
ccd_*.zip
